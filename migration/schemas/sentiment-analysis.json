{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Social Sentiment Analysis",
  "description": "Schema for Grok social intelligence outputs",
  "type": "object",
  "required": ["subject", "analysis_period", "overall_sentiment", "metrics"],
  "properties": {
    "subject": {
      "type": "string",
      "description": "Brand, topic, or entity being analyzed"
    },
    "analysis_period": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" },
        "duration": { "type": "string", "description": "e.g., '24h', '7d', '30d'" }
      }
    },
    "overall_sentiment": {
      "type": "object",
      "required": ["score", "label"],
      "properties": {
        "score": {
          "type": "number",
          "minimum": -1,
          "maximum": 1,
          "description": "Sentiment score from -1 (very negative) to +1 (very positive)"
        },
        "label": {
          "type": "string",
          "enum": ["very_negative", "negative", "slightly_negative", "neutral", "slightly_positive", "positive", "very_positive"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trend": {
          "type": "string",
          "enum": ["improving", "stable", "declining"]
        },
        "trend_change": {
          "type": "number",
          "description": "Change from previous period"
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "total_mentions": { "type": "integer" },
        "unique_authors": { "type": "integer" },
        "total_engagement": { "type": "integer" },
        "average_engagement": { "type": "number" },
        "share_of_voice": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Percentage of category conversation"
        },
        "reach": { "type": "integer", "description": "Estimated total reach" },
        "impressions": { "type": "integer" }
      }
    },
    "sentiment_distribution": {
      "type": "object",
      "properties": {
        "very_positive": { "type": "number" },
        "positive": { "type": "number" },
        "neutral": { "type": "number" },
        "negative": { "type": "number" },
        "very_negative": { "type": "number" }
      },
      "description": "Percentage distribution across sentiment categories"
    },
    "emotion_breakdown": {
      "type": "object",
      "properties": {
        "joy": { "type": "number" },
        "trust": { "type": "number" },
        "anticipation": { "type": "number" },
        "surprise": { "type": "number" },
        "fear": { "type": "number" },
        "sadness": { "type": "number" },
        "anger": { "type": "number" },
        "disgust": { "type": "number" }
      },
      "description": "Plutchik emotion wheel percentages"
    },
    "sentiment_timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "score": { "type": "number" },
          "volume": { "type": "integer" },
          "notable_event": { "type": "string" }
        }
      }
    },
    "trending_topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": { "type": "string" },
          "hashtag": { "type": "string" },
          "volume": { "type": "integer" },
          "sentiment": { "type": "number" },
          "trend": {
            "type": "string",
            "enum": ["rising", "stable", "falling"]
          }
        }
      }
    },
    "top_posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": { "type": "string" },
          "author": { "type": "string" },
          "author_followers": { "type": "integer" },
          "likes": { "type": "integer" },
          "reposts": { "type": "integer" },
          "replies": { "type": "integer" },
          "sentiment": { "type": "number" },
          "timestamp": { "type": "string", "format": "date-time" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "influencers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "handle": { "type": "string" },
          "name": { "type": "string" },
          "followers": { "type": "integer" },
          "engagement_rate": { "type": "number" },
          "sentiment_toward_subject": { "type": "number" },
          "influence_type": {
            "type": "string",
            "enum": ["thought_leader", "celebrity", "industry_expert", "grassroots", "media"]
          },
          "recent_mentions": { "type": "integer" }
        }
      }
    },
    "conversation_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "theme": { "type": "string" },
          "percentage": { "type": "number" },
          "sentiment": { "type": "number" },
          "key_terms": {
            "type": "array",
            "items": { "type": "string" }
          },
          "key_voices": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "warning", "info", "opportunity"]
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    },
    "competitive_comparison": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competitor": { "type": "string" },
          "mentions": { "type": "integer" },
          "sentiment": { "type": "number" },
          "share_of_voice": { "type": "number" },
          "engagement": { "type": "integer" }
        }
      }
    }
  }
}
