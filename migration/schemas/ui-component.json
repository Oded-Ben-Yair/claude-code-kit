{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI Component Specification",
  "description": "Schema for design-to-code component extraction",
  "type": "object",
  "required": ["component_name", "framework", "layout", "styles"],
  "properties": {
    "component_name": {
      "type": "string",
      "description": "PascalCase component name",
      "pattern": "^[A-Z][a-zA-Z0-9]*$"
    },
    "framework": {
      "type": "string",
      "enum": ["react", "vue", "svelte", "html"],
      "default": "react"
    },
    "layout": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["flex", "grid", "block", "inline"]
        },
        "direction": {
          "type": "string",
          "enum": ["row", "column", "row-reverse", "column-reverse"]
        },
        "alignment": {
          "type": "string",
          "enum": ["start", "center", "end", "stretch", "baseline"]
        },
        "justify": {
          "type": "string",
          "enum": ["start", "center", "end", "between", "around", "evenly"]
        },
        "gap": {
          "type": "string",
          "description": "Gap between children (e.g., '16px', '1rem')"
        },
        "padding": {
          "type": "string",
          "description": "Container padding"
        },
        "margin": {
          "type": "string",
          "description": "Container margin"
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["heading", "paragraph", "button", "input", "image", "link", "icon", "container", "list", "card"]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "description": "Heading level (h1-h6)"
          },
          "text": {
            "type": "string",
            "description": "Text content"
          },
          "variant": {
            "type": "string",
            "enum": ["primary", "secondary", "outline", "ghost", "link"],
            "description": "Button/component variant"
          },
          "placeholder": {
            "type": "string",
            "description": "Input placeholder"
          },
          "src": {
            "type": "string",
            "description": "Image source"
          },
          "alt": {
            "type": "string",
            "description": "Image alt text"
          },
          "href": {
            "type": "string",
            "description": "Link URL"
          },
          "icon": {
            "type": "string",
            "description": "Icon name (e.g., 'arrow-right', 'check')"
          },
          "children": {
            "$ref": "#/properties/children",
            "description": "Nested children for containers"
          }
        }
      }
    },
    "styles": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "properties": {
            "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "secondary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "text": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "muted": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "border": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          }
        },
        "typography": {
          "type": "object",
          "properties": {
            "fontFamily": { "type": "string" },
            "fontSize": {
              "type": "object",
              "properties": {
                "xs": { "type": "string" },
                "sm": { "type": "string" },
                "base": { "type": "string" },
                "lg": { "type": "string" },
                "xl": { "type": "string" },
                "2xl": { "type": "string" },
                "3xl": { "type": "string" }
              }
            },
            "fontWeight": {
              "type": "object",
              "properties": {
                "normal": { "type": "integer" },
                "medium": { "type": "integer" },
                "semibold": { "type": "integer" },
                "bold": { "type": "integer" }
              }
            },
            "lineHeight": {
              "type": "object",
              "properties": {
                "tight": { "type": "number" },
                "normal": { "type": "number" },
                "relaxed": { "type": "number" }
              }
            }
          }
        },
        "spacing": {
          "type": "object",
          "properties": {
            "unit": { "type": "integer", "default": 4, "description": "Base spacing unit in px" },
            "scale": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Spacing scale values"
            }
          }
        },
        "borderRadius": {
          "type": "object",
          "properties": {
            "none": { "type": "string" },
            "sm": { "type": "string" },
            "md": { "type": "string" },
            "lg": { "type": "string" },
            "xl": { "type": "string" },
            "full": { "type": "string" }
          }
        },
        "shadows": {
          "type": "object",
          "properties": {
            "sm": { "type": "string" },
            "md": { "type": "string" },
            "lg": { "type": "string" },
            "xl": { "type": "string" }
          }
        }
      }
    },
    "responsive": {
      "type": "object",
      "properties": {
        "breakpoints": {
          "type": "object",
          "properties": {
            "sm": { "type": "string", "default": "640px" },
            "md": { "type": "string", "default": "768px" },
            "lg": { "type": "string", "default": "1024px" },
            "xl": { "type": "string", "default": "1280px" }
          }
        },
        "variations": {
          "type": "object",
          "description": "Layout variations per breakpoint"
        }
      }
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "ariaLabel": { "type": "string" },
        "ariaDescribedBy": { "type": "string" },
        "role": { "type": "string" },
        "tabIndex": { "type": "integer" }
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trigger": {
            "type": "string",
            "enum": ["click", "hover", "focus", "scroll", "load"]
          },
          "action": {
            "type": "string",
            "enum": ["navigate", "toggle", "animate", "submit", "open", "close"]
          },
          "target": { "type": "string" },
          "animation": { "type": "string" }
        }
      }
    }
  }
}
