{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Research Report",
  "description": "Schema for structured research outputs from Perplexity agents",
  "type": "object",
  "required": ["title", "executive_summary", "findings", "sources"],
  "properties": {
    "title": {
      "type": "string",
      "description": "Research report title"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "research_type": {
          "type": "string",
          "enum": ["academic", "market", "competitive", "technical", "regulatory", "general"]
        },
        "depth": {
          "type": "string",
          "enum": ["quick", "standard", "deep", "exhaustive"]
        },
        "sources_analyzed": {
          "type": "integer"
        },
        "confidence_level": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "time_range": {
          "type": "object",
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" }
          }
        }
      }
    },
    "executive_summary": {
      "type": "string",
      "description": "2-3 paragraph overview of findings",
      "minLength": 100
    },
    "key_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding", "confidence"],
        "properties": {
          "finding": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "supporting_sources": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "minItems": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "content"],
        "properties": {
          "section": {
            "type": "string",
            "description": "Section title"
          },
          "content": {
            "type": "string",
            "description": "Section content"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim": { "type": "string" },
                "source": { "type": "string" },
                "strength": {
                  "type": "string",
                  "enum": ["strong", "moderate", "weak"]
                }
              }
            }
          },
          "subsections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "content": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "consensus": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": { "type": "string" },
          "position": { "type": "string" },
          "agreement_level": {
            "type": "string",
            "enum": ["strong", "moderate", "weak"]
          }
        }
      },
      "description": "Points where sources agree"
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": { "type": "string" },
          "position_a": {
            "type": "object",
            "properties": {
              "claim": { "type": "string" },
              "source": { "type": "string" }
            }
          },
          "position_b": {
            "type": "object",
            "properties": {
              "claim": { "type": "string" },
              "source": { "type": "string" }
            }
          },
          "analysis": { "type": "string" }
        }
      },
      "description": "Points where sources disagree"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": { "type": "string" },
          "description": { "type": "string" },
          "impact": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "recommendation": { "type": "string" }
        }
      },
      "description": "Information gaps identified"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recommendation"],
        "properties": {
          "recommendation": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "rationale": { "type": "string" },
          "supporting_evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "type": {
            "type": "string",
            "enum": ["academic", "news", "official", "blog", "report", "data", "other"]
          },
          "date": { "type": "string" },
          "author": { "type": "string" },
          "reliability": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "key_contribution": { "type": "string" }
        }
      },
      "minItems": 1
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Suggested follow-up research or actions"
    }
  }
}
