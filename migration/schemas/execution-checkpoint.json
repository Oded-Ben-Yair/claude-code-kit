{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude.ai/schemas/execution-checkpoint.json",
  "title": "Execution Checkpoint Schema",
  "description": "Schema for checkpointing orchestration state for resume after interruption",
  "version": "1.0.0",
  "lastUpdated": "2026-01-29",

  "type": "object",
  "required": ["checkpoint_id", "task_id", "created_at", "state", "resumable"],

  "properties": {
    "checkpoint_id": {
      "type": "string",
      "description": "Unique checkpoint identifier"
    },

    "task_id": {
      "type": "string",
      "description": "Task being checkpointed"
    },

    "plan_id": {
      "type": "string",
      "description": "Plan identifier from architect-planner"
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    },

    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this checkpoint becomes stale and should not be resumed"
    },

    "session_id": {
      "type": "string",
      "description": "Original Claude Code session"
    },

    "project": {
      "type": "string",
      "description": "Project directory"
    },

    "resumable": {
      "type": "boolean",
      "description": "Whether this checkpoint can be safely resumed"
    },

    "resume_warning": {
      "type": "string",
      "description": "Warning to show if resume might be risky"
    },

    "state": {
      "type": "object",
      "required": ["phase", "step_index", "plan"],
      "properties": {
        "phase": {
          "type": "string",
          "enum": ["planning", "plan_approval", "implementing", "reviewing", "iteration", "complete", "failed"]
        },
        "step_index": {
          "type": "integer",
          "minimum": 0,
          "description": "Current step index (0-based)"
        },
        "plan": {
          "type": "object",
          "properties": {
            "plan_id": { "type": "string" },
            "total_steps": { "type": "integer" },
            "steps": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": { "type": "integer" },
                  "description": { "type": "string" },
                  "status": {
                    "type": "string",
                    "enum": ["pending", "in_progress", "completed", "failed", "skipped"]
                  },
                  "files": { "type": "array", "items": { "type": "string" } },
                  "acceptance_criteria": { "type": "string" }
                }
              }
            }
          }
        },
        "iteration_count": {
          "type": "integer",
          "default": 0,
          "description": "Number of retry iterations for current step"
        },
        "total_iterations_used": {
          "type": "integer",
          "default": 0,
          "description": "Total iterations across all steps"
        }
      }
    },

    "context_snapshot": {
      "type": "object",
      "description": "Preserved context for resume",
      "properties": {
        "original_request": {
          "type": "string",
          "description": "User's original task request"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": { "type": "integer" },
              "decision": { "type": "string" },
              "rationale": { "type": "string" }
            }
          }
        },
        "patterns_used": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Pattern IDs from success_patterns.json"
        },
        "files_state": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "hash": { "type": "string" },
              "modified_at": { "type": "string", "format": "date-time" }
            }
          },
          "description": "File hashes at checkpoint time (to detect drift)"
        },
        "ledger_state": {
          "type": "object",
          "description": "Copy of status.json at checkpoint time"
        }
      }
    },

    "artifacts": {
      "type": "object",
      "properties": {
        "completed_outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step_index": { "type": "integer" },
              "files_created": { "type": "array", "items": { "type": "string" } },
              "files_modified": { "type": "array", "items": { "type": "string" } },
              "tests_added": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "pending_review": {
          "type": "object",
          "description": "Code awaiting review at checkpoint",
          "properties": {
            "step_index": { "type": "integer" },
            "changes_summary": { "type": "string" }
          }
        },
        "review_feedback": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step_index": { "type": "integer" },
              "verdict": { "type": "string" },
              "issues": { "type": "array", "items": { "type": "string" } }
            }
          },
          "description": "Review feedback received but not yet addressed"
        }
      }
    },

    "idempotency": {
      "type": "object",
      "description": "Tokens to prevent duplicate operations on resume",
      "properties": {
        "last_operation_token": {
          "type": "string",
          "description": "Token for the operation in progress when checkpointed"
        },
        "completed_operation_tokens": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tokens for operations that completed successfully"
        }
      }
    },

    "resume_instructions": {
      "type": "string",
      "description": "Human-readable instructions for resuming from this checkpoint"
    }
  },

  "examples": [
    {
      "checkpoint_id": "ckpt-20260129T120000-auth-impl",
      "task_id": "task-auth-001",
      "plan_id": "plan-20260129T110000",
      "created_at": "2026-01-29T12:00:00Z",
      "expires_at": "2026-01-30T12:00:00Z",
      "session_id": "claude-session-12345",
      "project": "sentimark",
      "resumable": true,
      "state": {
        "phase": "reviewing",
        "step_index": 2,
        "plan": {
          "plan_id": "plan-20260129T110000",
          "total_steps": 5,
          "steps": [
            { "index": 0, "description": "Create auth middleware", "status": "completed" },
            { "index": 1, "description": "Add JWT generation", "status": "completed" },
            { "index": 2, "description": "Create login endpoint", "status": "in_progress" },
            { "index": 3, "description": "Add route decorator", "status": "pending" },
            { "index": 4, "description": "Write tests", "status": "pending" }
          ]
        },
        "iteration_count": 1,
        "total_iterations_used": 1
      },
      "context_snapshot": {
        "original_request": "Add user authentication to the API",
        "decisions": [
          { "step": 0, "decision": "Use existing middleware pattern from logging.ts", "rationale": "Maintains consistency" },
          { "step": 1, "decision": "Use jsonwebtoken library", "rationale": "Already in package.json" }
        ],
        "patterns_used": ["pattern-001", "pattern-010"]
      },
      "artifacts": {
        "completed_outputs": [
          { "step_index": 0, "files_created": ["src/middleware/auth.ts"], "files_modified": [], "tests_added": ["tests/middleware/auth.spec.ts"] },
          { "step_index": 1, "files_created": ["src/utils/jwt.ts"], "files_modified": [], "tests_added": ["tests/utils/jwt.spec.ts"] }
        ],
        "pending_review": {
          "step_index": 2,
          "changes_summary": "Login endpoint created at POST /api/auth/login"
        }
      },
      "idempotency": {
        "last_operation_token": "idem-step2-review-20260129T120000",
        "completed_operation_tokens": ["idem-step0-impl", "idem-step0-review", "idem-step1-impl", "idem-step1-review"]
      },
      "resume_instructions": "Session interrupted during code review for step 3 (login endpoint). Resume by running code-judge on pending changes in src/routes/auth.ts"
    }
  ]
}
