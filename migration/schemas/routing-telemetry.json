{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://claude.ai/schemas/routing-telemetry.json",
  "title": "Routing Telemetry Schema",
  "description": "Telemetry data for tracking routing decisions and outcomes in Silent Kernel",
  "version": "1.0.0",
  "lastUpdated": "2026-01-29",

  "definitions": {
    "route_type": {
      "type": "string",
      "enum": ["agent", "skill", "mcp_tool", "direct", "escalation"]
    },
    "outcome": {
      "type": "string",
      "enum": ["success", "failure", "timeout", "override", "escalated", "partial"]
    }
  },

  "type": "object",
  "required": ["telemetry_id", "timestamp", "intent_classification", "route_selected", "execution"],

  "properties": {
    "telemetry_id": {
      "type": "string",
      "description": "Unique telemetry record ID (format: telem-{timestamp}-{random})"
    },

    "trace_id": {
      "type": "string",
      "description": "Trace ID linking related telemetry records across a task"
    },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "session_id": {
      "type": "string",
      "description": "Claude Code session ID for aggregation"
    },

    "project": {
      "type": "string",
      "description": "Project name from working directory"
    },

    "intent_classification": {
      "type": "object",
      "required": ["detected_intent", "confidence", "keywords_matched"],
      "properties": {
        "detected_intent": {
          "type": "string",
          "description": "Intent category from intent-classifier.json"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Classification confidence (0.0-1.0)"
        },
        "keywords_matched": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Keywords that triggered this classification"
        },
        "patterns_matched": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Regex patterns that matched"
        },
        "subtype_detected": {
          "type": "string",
          "description": "Subtype if applicable (e.g., 'rapid' for code_generation)"
        },
        "confidence_boosts_applied": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "trigger": { "type": "string" },
              "boost": { "type": "number" }
            }
          },
          "description": "Confidence boosts that were applied"
        },
        "alternative_intents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "intent": { "type": "string" },
              "confidence": { "type": "number" }
            }
          },
          "description": "Other intents considered with their confidence scores"
        }
      }
    },

    "route_selected": {
      "type": "object",
      "required": ["route_type", "target"],
      "properties": {
        "route_type": { "$ref": "#/definitions/route_type" },
        "target": {
          "type": "string",
          "description": "Agent name, skill name, or MCP tool name"
        },
        "mcp_server": {
          "type": "string",
          "description": "MCP server if applicable (perplexity, gemini, grok, etc.)"
        },
        "fallback_applied": {
          "type": "boolean",
          "default": false,
          "description": "Whether this was a fallback route"
        },
        "fallback_reason": {
          "type": "string",
          "description": "Reason for fallback if applied"
        }
      }
    },

    "execution": {
      "type": "object",
      "required": ["outcome", "duration_ms"],
      "properties": {
        "outcome": { "$ref": "#/definitions/outcome" },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Total execution time in milliseconds"
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase_name": { "type": "string" },
              "duration_ms": { "type": "integer" },
              "outcome": { "$ref": "#/definitions/outcome" }
            }
          },
          "description": "Breakdown by orchestration phases"
        },
        "retry_count": {
          "type": "integer",
          "default": 0
        },
        "error_type": {
          "type": "string",
          "description": "Error category if failed"
        },
        "error_message": {
          "type": "string",
          "description": "Error details if failed"
        },
        "user_override": {
          "type": "boolean",
          "default": false,
          "description": "Whether user manually changed the route"
        },
        "override_to": {
          "type": "string",
          "description": "What route user changed to (if overridden)"
        }
      }
    },

    "token_usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" },
        "total_tokens": { "type": "integer" },
        "model_used": {
          "type": "string",
          "description": "Primary model used"
        },
        "cost_estimate_usd": {
          "type": "number",
          "description": "Estimated cost in USD"
        },
        "by_agent": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input_tokens": { "type": "integer" },
              "output_tokens": { "type": "integer" },
              "model": { "type": "string" }
            }
          },
          "description": "Token usage broken down by agent"
        }
      }
    },

    "quality_metrics": {
      "type": "object",
      "properties": {
        "task_completed": {
          "type": "boolean",
          "description": "Whether the task was fully completed"
        },
        "verification_passed": {
          "type": "boolean",
          "description": "Whether code-judge approved (if applicable)"
        },
        "tests_passed": {
          "type": "boolean",
          "description": "Whether tests passed (if applicable)"
        },
        "user_satisfaction": {
          "type": "string",
          "enum": ["positive", "neutral", "negative", "unknown"],
          "description": "Inferred or explicit user feedback"
        },
        "follow_up_required": {
          "type": "boolean",
          "description": "Whether user needed to ask follow-up questions"
        }
      }
    },

    "context_metrics": {
      "type": "object",
      "properties": {
        "context_size_tokens": {
          "type": "integer",
          "description": "Context window usage at start"
        },
        "files_read": {
          "type": "integer",
          "description": "Number of files read"
        },
        "files_modified": {
          "type": "integer",
          "description": "Number of files modified"
        },
        "compaction_triggered": {
          "type": "boolean",
          "description": "Whether auto-compaction was triggered"
        }
      }
    },

    "learning_signal": {
      "type": "object",
      "description": "Signals for routing calibration",
      "properties": {
        "should_calibrate": {
          "type": "boolean",
          "description": "Whether this record suggests routing calibration needed"
        },
        "calibration_direction": {
          "type": "string",
          "enum": ["increase_confidence", "decrease_confidence", "add_keyword", "change_route"],
          "description": "What kind of calibration might help"
        },
        "suggested_change": {
          "type": "string",
          "description": "Specific calibration suggestion"
        }
      }
    }
  },

  "examples": [
    {
      "telemetry_id": "telem-20260129T120000-abc123",
      "trace_id": "trace-session-xyz-001",
      "timestamp": "2026-01-29T12:00:00Z",
      "session_id": "claude-code-session-12345",
      "project": "sentimark",
      "intent_classification": {
        "detected_intent": "research",
        "confidence": 0.85,
        "keywords_matched": ["research", "find out"],
        "patterns_matched": ["^(can you |please )?(research|find|look up)"],
        "subtype_detected": null,
        "confidence_boosts_applied": [
          { "trigger": "academic", "boost": 0.2 }
        ],
        "alternative_intents": [
          { "intent": "library_docs", "confidence": 0.45 }
        ]
      },
      "route_selected": {
        "route_type": "mcp_tool",
        "target": "perplexity_research",
        "mcp_server": "perplexity",
        "fallback_applied": false
      },
      "execution": {
        "outcome": "success",
        "duration_ms": 12500,
        "retry_count": 0
      },
      "token_usage": {
        "input_tokens": 1200,
        "output_tokens": 3500,
        "total_tokens": 4700,
        "model_used": "claude-opus-4-5",
        "cost_estimate_usd": 0.08
      },
      "quality_metrics": {
        "task_completed": true,
        "user_satisfaction": "positive",
        "follow_up_required": false
      },
      "learning_signal": {
        "should_calibrate": false
      }
    }
  ]
}
