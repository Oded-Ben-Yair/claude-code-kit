{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Capability registry for auto-enriching Claude Code plans",
  "capabilities": {
    "agents": [
      {
        "id": "architect-planner",
        "name": "Architect Planner",
        "type": "agent",
        "description": "Senior software architect that analyzes, plans, and decomposes tasks WITHOUT writing code. Finds patterns, creates step-by-step plans, assesses risk.",
        "triggers": ["architect", "plan", "design", "decompose", "scope", "breakdown", "task planning", "architecture"],
        "inputs": ["user request", "codebase context", "requirements"],
        "outputs": ["implementation plan", "task breakdown", "risk assessment", "critical files list"],
        "mcp": "azure-ai-foundry",
        "tools": ["azure_brainstorm", "azure_reason"],
        "cost_tier": "medium",
        "latency": "medium"
      },
      {
        "id": "code-worker",
        "name": "Code Worker",
        "type": "agent",
        "description": "Focused implementer that executes plans exactly. Searches for patterns before coding, writes tests alongside implementation, creates checkpoints.",
        "triggers": ["implement", "build", "code", "create", "fix", "develop", "worker", "quick fix", "fast code", "snippet", "rapid prototype", "small fix"],
        "inputs": ["plan from architect", "patterns to follow", "test requirements"],
        "outputs": ["code", "tests", "checkpoint notes", "implementation summary"],
        "mcp": "azure-ai-foundry",
        "tools": ["grok_code", "azure_chat"],
        "cost_tier": "medium",
        "latency": "medium"
      },
      {
        "id": "code-judge",
        "name": "Code Judge",
        "type": "agent",
        "description": "Hostile code reviewer that validates implementations. Checks pattern compliance, security, tests, and performance. Returns APPROVE/REVISE/REJECT verdicts.",
        "triggers": ["review", "judge", "validate", "critique", "check code", "approve", "code review"],
        "inputs": ["code changes", "implementation", "diff"],
        "outputs": ["verdict", "issues list", "security audit", "recommendations"],
        "mcp": "gemini",
        "tools": ["gemini-analyze-code", "azure_code_review"],
        "cost_tier": "medium",
        "latency": "medium"
      },
      {
        "id": "code-simplifier",
        "name": "Code Simplifier",
        "type": "agent",
        "description": "Simplifies and refines recently modified code for clarity, consistency, and maintainability. Preserves functionality. Plugin-provided (claude-plugins-official).",
        "triggers": ["simplify", "refine code", "clean up code", "reduce complexity", "improve readability", "code clarity"],
        "inputs": ["recently modified code", "code files"],
        "outputs": ["simplified code", "refactoring summary"],
        "cost_tier": "medium",
        "latency": "medium",
        "source": "plugin:code-simplifier"
      },
      {
        "id": "gemini-specialist",
        "name": "Gemini Specialist (Consolidated)",
        "type": "agent",
        "description": "Unified Gemini 3 Pro agent for vision, documents, images, and reasoning. Consolidates 7 specialized Gemini agents.",
        "triggers": ["PDF", "document", "image", "screenshot", "video", "chart", "visualization", "accessibility", "WCAG", "OCR", "design to code"],
        "inputs": ["image", "document", "video", "screenshot", "data"],
        "outputs": ["analysis", "extracted data", "generated images", "code"],
        "mcp": "gemini",
        "cost_tier": "medium",
        "latency": "medium",
        "consolidates": ["gemini-doc-parser", "gemini-asset-producer", "gemini-video-analyzer", "gemini-viz-generator", "gemini-ui-auditor", "gemini-deep-reasoner", "gemini-design-coder"]
      },
      {
        "id": "research-specialist",
        "name": "Research Specialist (Consolidated)",
        "type": "agent",
        "description": "Unified Perplexity agent for research, investigation, and information gathering. Consolidates 4 specialized Perplexity agents.",
        "triggers": ["research", "find out", "investigate", "academic", "SEC", "financial", "papers", "current events"],
        "inputs": ["query", "topic", "research question"],
        "outputs": ["research summary", "citations", "analysis"],
        "mcp": "perplexity",
        "cost_tier": "medium",
        "latency": "medium",
        "consolidates": ["perplexity-academic-researcher", "perplexity-deep-research", "perplexity-geo-researcher", "perplexity-sec-analyst"]
      },
      {
        "id": "realtime-specialist",
        "name": "Real-time Specialist (Consolidated)",
        "type": "agent",
        "description": "Unified Grok agent for social media, real-time data, and human-like content. Consolidates 3 specialized Grok agents.",
        "triggers": ["Twitter", "X", "trending", "social media", "viral", "tweet", "competitive intel", "brand monitoring"],
        "inputs": ["topic", "brand", "query"],
        "outputs": ["social pulse", "content", "competitive analysis"],
        "mcp": "grok",
        "cost_tier": "medium",
        "latency": "low",
        "consolidates": ["grok-brand-writer", "grok-social-pulse", "grok-competitive-intel"]
      },
      {
        "id": "reasoning-specialist",
        "name": "Reasoning Specialist (Consolidated)",
        "type": "agent",
        "description": "Unified agent for complex reasoning, math, algorithms, brainstorming, and decision analysis. Consolidates 5 specialized agents.",
        "triggers": ["brainstorm", "prove", "theorem", "algorithm", "decision", "trade-offs", "complex reasoning", "mathematical"],
        "inputs": ["problem", "topic", "decision"],
        "outputs": ["analysis", "proof", "ideas", "decision matrix"],
        "mcp": "azure-ai-foundry",
        "cost_tier": "high",
        "latency": "high",
        "consolidates": ["deepseek-speciale-reasoner", "gpt5-pro-brainstormer", "gpt5-pro-decision-panel", "gpt52-context-weaver", "gemini-deep-reasoner"]
      }
    ],
    "skills": [
      {
        "id": "multi-model-debate",
        "name": "Multi-Model Debate",
        "type": "skill",
        "description": "Orchestrates structured debate between 6 AI models for complex decisions",
        "triggers": ["debate", "multiple perspectives", "complex decision", "high-stakes", "architectural decision"],
        "auto_use": false
      },
      {
        "id": "azure-unified",
        "name": "Azure Unified",
        "type": "skill",
        "description": "Azure deployment, DevOps, Functions, SSO integration",
        "triggers": ["deploy to azure", "azure function", "azure devops", "azure sso"],
        "auto_use": true
      },
      {
        "id": "gemini3-pro",
        "name": "Gemini 3 Pro",
        "type": "skill",
        "description": "Using Gemini 3 features - thinking levels, media resolution, image generation",
        "triggers": ["gemini", "image generation", "vision analysis", "multimodal"],
        "auto_use": true
      },
      {
        "id": "frontend",
        "name": "Frontend (Unified)",
        "type": "skill",
        "description": "Unified frontend skill with smart routing. Single entry point for ALL frontend/design work: design-to-code, premium effects, typography, Figma workflows, accessibility auditing, visual verification.",
        "triggers": ["frontend", "design", "ui", "ux", "component", "css", "tailwind", "react", "design to code", "implement design", "figma", "screenshot to code", "premium UI", "effects", "animations", "hover", "typography", "accessibility", "a11y", "WCAG", "visual", "hero section", "landing page", "card", "button"],
        "auto_use": true,
        "modes": ["design-to-code", "figma", "effects", "audit"],
        "replaces": ["design-to-code", "premium-frontend", "premium-effects", "figma"]
      },
      {
        "id": "write-plan",
        "name": "Write Plan",
        "type": "skill",
        "description": "Create detailed implementation plan with bite-sized tasks",
        "triggers": ["write plan", "create plan", "implementation plan", "task breakdown"],
        "auto_use": true,
        "source": "superpowers"
      },
      {
        "id": "image-asset-studio",
        "name": "Image Asset Studio",
        "type": "skill",
        "description": "Comprehensive image asset creation and editing using Gemini 3 Pro Image - icons, logos, banners, editing, compositing",
        "triggers": ["image asset", "app icon", "logo", "banner", "mockup", "inpaint", "outpaint", "composite image", "product photo", "data visualization", "edit image", "extend image"],
        "auto_use": true
      },
      {
        "id": "learning-loop",
        "name": "Learning Loop",
        "type": "skill",
        "description": "Extracts learnings from sessions, updates success/failure patterns, persists to Memory MCP. Human-gated policy updates.",
        "triggers": ["extract learnings", "update patterns", "session learning", "what worked", "what failed"],
        "auto_use": true,
        "integration": "end-of-session"
      },
      {
        "id": "morning-update",
        "name": "Morning Update",
        "type": "skill",
        "description": "Daily briefing skill - reviews research findings, proposes rule updates, shows pattern health. First session of day.",
        "triggers": ["morning update", "daily briefing", "what's new", "daily update"],
        "auto_use": false
      },
      {
        "id": "architecture-doc",
        "name": "Architecture Documentation",
        "type": "skill",
        "description": "Generates comprehensive PDF-ready architecture documentation with Mermaid diagrams and Gemini analysis.",
        "triggers": ["architecture doc", "generate docs", "project documentation", "architecture pdf", "dependency map", "mermaid diagram"],
        "auto_use": false,
        "outputs": ["ARCHITECTURE.md", "PDF"]
      },
      {
        "id": "fix-pipeline",
        "name": "Fix Pipeline",
        "type": "skill",
        "description": "Auto-diagnose and fix CI/CD pipeline failures. Fetches logs, identifies root cause, launches code-worker to fix. Max 2 auto-fix attempts.",
        "triggers": ["pipeline failed", "build error", "CI failed", "deployment error", "fix build", "pipeline error", "azure pipeline"],
        "auto_use": true,
        "safety": {
          "max_attempts": 2,
          "requires_approval_for": ["pipeline yaml", "azure infrastructure"]
        }
      },
      {
        "id": "scrap-reimplement",
        "name": "Scrap and Reimplement",
        "type": "skill",
        "description": "Destructive recovery pattern - stash broken code, reimplement from spec. Use after 3+ failed fix attempts.",
        "triggers": ["scrap it", "start over", "rewrite this", "looping on fix", "too many patches", "3rd attempt"],
        "auto_use": false,
        "safety": {
          "requires_backup": true,
          "max_files": 3
        }
      },
      {
        "id": "pre-mortem",
        "name": "Pre-Mortem",
        "type": "skill",
        "description": "Risk assessment before implementation. Imagines failure to discover problems early. Auto-triggers on tasks touching 3+ files or involving auth/secrets/crypto/infra.",
        "triggers": ["risky task", "risk assessment", "pre-mortem", "3+ files", "auth", "crypto", "infrastructure", "database schema", "be careful"],
        "auto_use": true,
        "auto_trigger_conditions": ["task touches 3+ files", "involves auth/secrets/crypto/infra/DB schema"]
      },
      {
        "id": "ship-it",
        "name": "Ship It",
        "type": "skill",
        "description": "Anti-perfectionism skill. Declares 'good enough' and blocks endless improvement loops. Use when scope creep threatens delivery.",
        "triggers": ["is this done", "good enough", "scope creep", "perfectionism", "one more thing", "ship it", "done yet"],
        "auto_use": false
      },
      {
        "id": "find-solution",
        "name": "Find Solution",
        "type": "skill",
        "description": "Searches available MCPs, agents, skills to find solutions when stuck or looping.",
        "triggers": ["stuck", "looping", "can't fix", "which tool", "find solution", "help me find"],
        "auto_use": true
      },
      {
        "id": "browser-control",
        "name": "Browser Control",
        "type": "skill",
        "description": "Browser automation via CDP to leverage authenticated web services. Uses Edge sessions for Perplexity Pro, ChatGPT Pro, LinkedIn, HeyGen, Google AI Studio, and more.",
        "triggers": ["browser", "perplexity pro", "chatgpt pro", "linkedin", "heygen", "google ai studio", "web research", "create video", "design inspiration", "multi-ai"],
        "auto_use": false,
        "requires": "Edge running with --remote-debugging-port=9222",
        "services": ["perplexity", "chatgpt", "linkedin", "heygen", "google-ai-studio", "canva", "dribbble", "awwwards", "huggingface"]
      },
      {
        "id": "go",
        "name": "Session Resume",
        "type": "skill",
        "description": "Resume from last session with full context recovery, status briefing, and auto-planned action plan.",
        "triggers": ["go", "let's go", "where were we", "continue", "resume"],
        "auto_use": true
      },
      {
        "id": "end-of-session",
        "name": "End of Session",
        "type": "skill",
        "description": "Perfect session continuation with Memory MCP persistence, session index, validation gate, and handover.",
        "triggers": ["end session", "close session", "wrap up", "done for today"],
        "auto_use": false
      },
      {
        "id": "b2b-copy-writer",
        "name": "B2B Copy Writer",
        "type": "skill",
        "description": "B2B SaaS website copy generation using PAS framework with anti-slop rules.",
        "triggers": ["copy", "headline", "tagline", "landing page", "website copy"],
        "auto_use": false
      },
      {
        "id": "clean-env",
        "name": "Clean Environment",
        "type": "skill",
        "description": "Deep WSL + Windows cleanup - kills orphan processes, clears caches, reclaims memory.",
        "triggers": ["clean", "cleanup", "slow", "stuck", "heavy"],
        "auto_use": false
      },
      {
        "id": "dockerize-project",
        "name": "Dockerize Project",
        "type": "skill",
        "description": "Dockerize project backends for production deployment. Frontend stays on Azure Static Web Apps.",
        "triggers": ["docker", "dockerize", "containerize", "acr"],
        "auto_use": false
      }
    ],
    "mcps": [
      {
        "id": "memory",
        "name": "Memory MCP",
        "type": "mcp",
