        "triggers": ["remember", "persist", "store decision", "save for later", "recall", "memory"],
        "tools": ["create_entities", "create_relations", "add_observations", "search_nodes", "read_graph"]
      },
      {
        "id": "perplexity",
        "name": "Perplexity MCP",
