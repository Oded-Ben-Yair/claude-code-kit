# Sentimark Brand Theme for D2 Diagrams
# Usage: Copy these classes into your .d2 file, then render with:
#   d2 --layout=elk --theme=200 input.d2 output.svg
#
# Brand Colors:
#   Trade green:  #2ecc71 / #27ae60
#   No-trade red: #e74c3c / #c0392b
#   Data blue:    #3498db / #2980b9
#   Gate orange:  #f39c12 / #e67e22
#   Shadow gray:  #95a5a6 / #7f8c8d
#   Stored purple:#9b59b6 / #8e44ad
#   Result teal:  #1abc9c / #16a085
#   Block crimson:#c0392b / #922b21

classes: {
  trade: {
    style: {
      fill: "#2ecc71"
      stroke: "#27ae60"
      font-color: "#ffffff"
      stroke-width: 2
      border-radius: 5
    }
  }
  notrade: {
    style: {
      fill: "#e74c3c"
      stroke: "#c0392b"
      font-color: "#ffffff"
      stroke-width: 2
      border-radius: 5
    }
  }
  data: {
    style: {
      fill: "#3498db"
      stroke: "#2980b9"
      font-color: "#ffffff"
      stroke-width: 2
      border-radius: 5
    }
  }
  gate: {
    style: {
      fill: "#f39c12"
      stroke: "#e67e22"
      font-color: "#ffffff"
      stroke-width: 2
      border-radius: 5
    }
  }
  shadow: {
    style: {
      fill: "#95a5a6"
      stroke: "#7f8c8d"
      font-color: "#ffffff"
      stroke-width: 2
      border-radius: 5
    }
  }
  stored: {
    style: {
      fill: "#9b59b6"
      stroke: "#8e44ad"
      font-color: "#ffffff"
      stroke-width: 2
      border-radius: 5
    }
  }
  result: {
    style: {
      fill: "#1abc9c"
      stroke: "#16a085"
      font-color: "#ffffff"
      stroke-width: 2
      border-radius: 5
    }
  }
  block: {
    style: {
      fill: "#c0392b"
      stroke: "#922b21"
      font-color: "#ffffff"
      stroke-width: 2
      border-radius: 5
    }
  }
  decision: {
    shape: diamond
    style: {
      fill: "#f39c12"
      stroke: "#e67e22"
      font-color: "#ffffff"
      stroke-width: 2
    }
  }
  container: {
    style: {
      fill: "#1a1a2e"
      stroke: "#16213e"
      font-color: "#e0e0e0"
      stroke-width: 1
      border-radius: 8
    }
  }
}
