#!/usr/bin/env python3
"""Multi-provider AI MCP Server -- routes to Vertex AI, Grok, or local models.

Generated by export-kit-generator.py. Customize for your GCP project.
"""

import json
import os

import httpx
from mcp.server.fastmcp import FastMCP

mcp = FastMCP("multi-provider-ai")

# Provider configuration
VERTEX_PROJECT = os.environ.get("GCP_PROJECT", "")
VERTEX_REGION = os.environ.get("GCP_REGION", "us-central1")
GROK_API_KEY = os.environ.get("GROK_API_KEY", "")


def _vertex_endpoint(model: str) -> str:
    """Build Vertex AI prediction endpoint URL."""
    return (
        f"https://{VERTEX_REGION}-aiplatform.googleapis.com/v1/"
        f"projects/{VERTEX_PROJECT}/locations/{VERTEX_REGION}/"
        f"publishers/google/models/{model}:generateContent"
    )


async def _get_adc_token() -> str:
    """Get access token from Application Default Credentials."""
    import subprocess

    result = subprocess.run(
        ["gcloud", "auth", "application-default", "print-access-token"],
        capture_output=True,
        text=True,
        timeout=10,
    )
    if result.returncode != 0:
        raise RuntimeError(f"ADC token failed: {result.stderr.strip()}")
    return result.stdout.strip()


@mcp.tool()
async def vertex_chat(prompt: str, model: str = "gemini-2.0-flash") -> str:
    """Chat with Vertex AI models (Gemini, Claude via Vertex).

    Args:
        prompt: The prompt to send to the model.
        model: Vertex AI model ID. Default: gemini-2.0-flash.
    """
    if not VERTEX_PROJECT:
        return "[vertex_chat] NOT CONNECTED. Set GCP_PROJECT env var."

    token = await _get_adc_token()
    url = _vertex_endpoint(model)

    async with httpx.AsyncClient(timeout=120.0) as client:
        resp = await client.post(
            url,
            headers={"Authorization": f"Bearer {token}"},
            json={
                "contents": [{"role": "user", "parts": [{"text": prompt}]}],
                "generationConfig": {"temperature": 0.7, "maxOutputTokens": 8192},
            },
        )
        resp.raise_for_status()
        data = resp.json()

    candidates = data.get("candidates", [])
    if not candidates:
        return "[vertex_chat] No response from model."
    parts = candidates[0].get("content", {}).get("parts", [])
    return "".join(p.get("text", "") for p in parts)


@mcp.tool()
async def vertex_code_review(code: str, language: str = "python") -> str:
    """Code review using Vertex AI.

    Args:
        code: Source code to review.
        language: Programming language of the code.
    """
    prompt = (
        f"Review the following {language} code for bugs, security issues, "
        f"and best practice violations. Be specific with line references.\n\n"
        f"```{language}\n{code}\n```"
    )
    return await vertex_chat(prompt, model="gemini-2.0-flash")


@mcp.tool()
async def vertex_brainstorm(topic: str, num_ideas: int = 5) -> str:
    """Brainstorm ideas using Vertex AI.

    Args:
        topic: The topic to brainstorm about.
        num_ideas: Number of ideas to generate.
    """
    prompt = f"Generate {num_ideas} creative, actionable ideas for: {topic}"
    return await vertex_chat(prompt, model="gemini-2.0-flash")


@mcp.tool()
async def vertex_reason(problem: str) -> str:
    """Deep reasoning using Vertex AI thinking model.

    Args:
        problem: The problem requiring step-by-step reasoning.
    """
    if not VERTEX_PROJECT:
        return "[vertex_reason] NOT CONNECTED. Set GCP_PROJECT env var."

    token = await _get_adc_token()
    url = _vertex_endpoint("gemini-2.0-flash-thinking-exp")

    async with httpx.AsyncClient(timeout=180.0) as client:
        resp = await client.post(
            url,
            headers={"Authorization": f"Bearer {token}"},
            json={
                "contents": [{"role": "user", "parts": [{"text": problem}]}],
                "generationConfig": {"temperature": 1.0, "maxOutputTokens": 16384},
            },
        )
        resp.raise_for_status()
        data = resp.json()

    candidates = data.get("candidates", [])
    if not candidates:
        return "[vertex_reason] No response from model."
    parts = candidates[0].get("content", {}).get("parts", [])
    return "".join(p.get("text", "") for p in parts)


if __name__ == "__main__":
    mcp.run()
