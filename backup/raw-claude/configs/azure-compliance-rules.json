  "title": "Azure Compliance Rules Configuration",
  "version": "1.0.0",
  "lastUpdated": "2026-02-22",
  "naming": {
    "pattern": "^(COMP|func|app|swa|db|sa|vnet|acr|kv)-[a-zA-Z0-9-]+-(DEV|STAGING|PROD|dev|staging|prod)$",
    "sysadmin_naming_note": "Sysadmin uses COMP- prefix with UPPERCASE env (e.g., COMP-SEEKAPAAITRAININGAPI-PROD). Our lowercase func-/app- also accepted.",
    "separator": "-",
    "case": "lowercase",
    "type_map": {
      "func": "Azure Function App",
      "app": "App Service / Web App",
      "swa": "Static Web App",
      "db": "Database",
      "sa": "Storage Account",
      "vnet": "Virtual Network",
      "acr": "Container Registry",
      "kv": "Key Vault"
    },
    "environments": [
      "dev",
      "staging",
      "prod"
    ]
  },
  "tags": {
    "required": [
      "Brand",
      "Project",
      "Environment"
    ],
    "brand_values": {
      "Seekapa": [
        "qc-analyzer",
        "cs-agents",
        "training",
        "compliance-exam",
        "phone-spam-checker",
