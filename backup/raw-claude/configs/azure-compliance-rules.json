  "rules": [
    {
      "id": "R001",
      "name": "resource-group",
      "description": "All resources must be in Az-ai resource group",
      "severity": "critical",
      "auto_fixable": true,
      "check_command": "az resource list -g Az-ai --query \"[?resourceGroup!='Az-ai']\""
    },
    {
      "id": "R002",
      "name": "region",
      "description": "All resources must be in swedencentral",
      "severity": "critical",
      "auto_fixable": false,
      "check_command": "az resource list -g Az-ai --query \"[?location!='swedencentral']\""
    },
    {
      "id": "R003",
      "name": "naming-convention",
      "description": "Resource names must follow [type]-[project]-[env] pattern",
      "severity": "high",
      "auto_fixable": false,
      "check_command": null
    },
    {
      "id": "R004",
      "name": "required-tags",
      "description": "All resources must have Brand, Project, Environment tags",
      "severity": "high",
      "auto_fixable": true,
      "check_command": "az resource list -g Az-ai --query \"[?tags.Brand==null || tags.Project==null || tags.Environment==null]\""
    },
    {
      "id": "R005",
      "name": "shared-storage",
      "description": "Must use existing stsentimarkv2 storage account",
      "severity": "medium",
      "auto_fixable": false,
      "check_command": "az storage account list -g Az-ai --query \"[?name!='stsentimarkv2']\""
    },
    {
      "id": "R006",
      "name": "shared-asp",
      "description": "All backends must use ASP-AZAIPROJECTS App Service Plan",
      "severity": "medium",
      "auto_fixable": false,
      "check_command": null
    },
    {
      "id": "R007",
      "name": "swa-free-tier",
      "description": "Frontend Static Web Apps must use Free tier",
      "severity": "low",
      "auto_fixable": false,
      "check_command": null
    },
    {
      "id": "R008",
      "name": "shared-postgresql",
      "description": "Must use existing PostgreSQL server, never create new",
      "severity": "medium",
      "auto_fixable": false,
      "check_command": null
    }
  ]
