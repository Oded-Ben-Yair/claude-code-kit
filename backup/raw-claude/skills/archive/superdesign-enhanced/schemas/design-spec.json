{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DesignSpec",
  "description": "Structured specification for UI design analysis",
  "type": "object",
  "properties": {
    "layout": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["flex", "grid", "absolute", "fixed"]
        },
        "direction": {
          "type": "string",
          "enum": ["row", "column", "row-reverse", "column-reverse"]
        },
        "gaps": {
          "type": "string"
        },
        "structure": {
          "type": "string"
        }
      },
      "required": ["type", "structure"]
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["button", "input", "card", "nav", "header", "footer", "sidebar", "modal", "dropdown", "table", "form", "image", "icon", "text", "link", "badge", "avatar", "tabs", "accordion", "other"]
          },
          "content": {
            "type": "string"
          },
          "styling": {
            "type": "object",
            "properties": {
              "background": { "type": "string" },
              "text": { "type": "string" },
              "border": { "type": "string" },
              "rounded": { "type": "string" },
              "shadow": { "type": "string" },
              "padding": { "type": "string" },
              "margin": { "type": "string" }
            }
          },
          "position": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "items": { "$ref": "#/properties/components/items" }
          }
        },
        "required": ["type"]
      }
    },
    "colors": {
      "type": "object",
      "properties": {
        "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "secondary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "background": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "surface": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "text": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "textMuted": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "success": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "warning": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "error": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "info": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "typography": {
      "type": "object",
      "properties": {
        "fontFamily": { "type": "string" },
        "headings": {
          "type": "object",
          "properties": {
            "size": { "type": "string" },
            "weight": { "type": "number" },
            "lineHeight": { "type": "string" }
          }
        },
        "body": {
          "type": "object",
          "properties": {
            "size": { "type": "string" },
            "weight": { "type": "number" },
            "lineHeight": { "type": "string" }
          }
        },
        "small": {
          "type": "object",
          "properties": {
            "size": { "type": "string" },
            "weight": { "type": "number" },
            "lineHeight": { "type": "string" }
          }
        }
      }
    },
    "spacing": {
      "type": "object",
      "properties": {
        "xs": { "type": "string" },
        "sm": { "type": "string" },
        "md": { "type": "string" },
        "lg": { "type": "string" },
        "xl": { "type": "string" },
        "2xl": { "type": "string" }
      }
    },
    "interactions": {
      "type": "object",
      "properties": {
        "hoverStates": { "type": "array", "items": { "type": "string" } },
        "animations": { "type": "array", "items": { "type": "string" } },
        "transitions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "required": ["layout", "components", "colors"]
}
