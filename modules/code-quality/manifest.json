{
  "name": "code-quality",
  "version": "2.0.0",
  "description": "Code standards, schema-first development, test requirements, and file safety guards",
  "when_to_use": "Any project where you want enforced code quality — auto-formatting, file guards, dead code detection, and security validation",
  "type": "universal",
  "depends_on": ["core"],
  "files": {
    "rules": ["code-quality.md", "db-safety.md", "cleanup-safety.md"],
    "hooks": ["post-tool-autoformat.sh", "pre-tool-file-guard.sh", "dead-code-check.sh", "quality-validation.sh", "schema-verify.sh"],
    "checklists": ["before-bugfix.md", "before-deploy.md", "before-ml-change.md", "before-new-file.md", "before-pipeline-change.md", "before-refactor.md"]
  },
  "settings_merge": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {"type": "command", "command": "{CLAUDE_HOME}/hooks/schema-verify.sh", "timeout": 5},
            {"type": "command", "command": "{CLAUDE_HOME}/hooks/quality-validation.sh \"$TOOL_NAME\" \"$TOOL_INPUT\"", "timeout": 5},
            {"type": "command", "command": "{CLAUDE_HOME}/hooks/pre-tool-file-guard.sh", "timeout": 5},
            {"type": "command", "command": "{CLAUDE_HOME}/hooks/dead-code-check.sh", "timeout": 5}
          ]
        },
        {
          "matcher": "Write|Edit",
          "hooks": [
            {"type": "command", "command": "{CLAUDE_HOME}/hooks/quality-validation.sh \"$TOOL_NAME\" \"$TOOL_INPUT\"", "timeout": 5},
            {"type": "command", "command": "{CLAUDE_HOME}/hooks/pre-tool-file-guard.sh", "timeout": 5}
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit|Write",
          "hooks": [
            {"type": "command", "command": "{CLAUDE_HOME}/hooks/post-tool-autoformat.sh", "timeout": 30}
          ]
        }
      ]
    }
  },
  "claude_md_section": "code-quality"
}
