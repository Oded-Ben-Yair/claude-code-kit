{
  "name": "orchestration",
  "version": "2.0.0",
  "description": "Planning, parallel execution, team management, and risk assessment",
  "when_to_use": "Any project with multi-step tasks, agent teams, or parallel work. Provides structured planning, team templates, and pre-mortem risk assessment.",
  "type": "universal",
  "depends_on": ["core"],
  "files": {
    "skills": ["pre-mortem/"],
    "agents": ["architect-planner.md"],
    "hooks": ["teammate-idle-verify.sh", "task-completed-verify.sh", "subagent-stop-tracker.sh", "tool-failure-tracker.sh", "config-change-audit.sh", "worktree-audit.sh"],
    "rules": ["orchestration-patterns.md", "team-templates.md"]
  },
  "settings_merge": {
    "hooks": {
      "TeammateIdle": [
        {"matcher": "", "hooks": [{"type": "command", "command": "{CLAUDE_HOME}/hooks/teammate-idle-verify.sh", "timeout": 10}]}
      ],
      "TaskCompleted": [
        {"matcher": "", "hooks": [{"type": "command", "command": "{CLAUDE_HOME}/hooks/task-completed-verify.sh", "timeout": 15}]}
      ],
      "SubagentStop": [
        {"matcher": "", "hooks": [{"type": "command", "command": "{CLAUDE_HOME}/hooks/subagent-stop-tracker.sh", "timeout": 10}]}
      ],
      "PostToolUseFailure": [
        {"matcher": "", "hooks": [{"type": "command", "command": "{CLAUDE_HOME}/hooks/tool-failure-tracker.sh", "timeout": 10}]}
      ],
      "ConfigChange": [
        {"matcher": "", "hooks": [{"type": "command", "command": "{CLAUDE_HOME}/hooks/config-change-audit.sh", "timeout": 5}]}
      ],
      "WorktreeCreate": [
        {"matcher": "", "hooks": [{"type": "command", "command": "{CLAUDE_HOME}/hooks/worktree-audit.sh", "timeout": 5}]}
      ],
      "WorktreeRemove": [
        {"matcher": "", "hooks": [{"type": "command", "command": "{CLAUDE_HOME}/hooks/worktree-audit.sh", "timeout": 5}]}
      ]
    }
  },
  "claude_md_section": "orchestration"
}
