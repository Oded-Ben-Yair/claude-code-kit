{
  "name": "productivity",
  "version": "2.0.0",
  "description": "Anti-perfectionism, learning loops, diagrams, and intelligent routing",
  "when_to_use": "Any project where you want smart task routing, scope control, continuous improvement, and professional diagrams",
  "type": "universal",
  "depends_on": ["core"],
  "files": {
    "skills": ["ship-it/", "learning-loop/", "morning-update/", "create-diagram/"],
    "agents": ["code-simplifier.md"],
    "hooks": ["auto-router.py"],
    "rules": ["diagramming.md"],
    "scripts": ["render-mermaid.js"],
    "themes": []
  },
  "settings_merge": {
    "hooks": {
      "UserPromptSubmit": [
        {
          "matcher": "",
          "hooks": [
            {
              "type": "command",
              "command": "{CLAUDE_HOME}/hooks/auto-router.py",
              "timeout": 2
            }
          ]
        }
      ]
    }
  },
  "claude_md_section": "productivity"
}
