{
  "name": "engineering-discipline",
  "version": "2.0.0",
  "description": "Debugging, TDD, verification, and code review workflows",
  "when_to_use": "Any project where you want structured debugging, test-first development, and rigorous code review. Enforces evidence-before-assertions and systematic root cause analysis.",
  "type": "universal",
  "depends_on": ["core", "code-quality"],
  "files": {
    "agents": ["code-judge.md"],
    "hooks": ["debug-first.sh", "test-result-tracker.sh", "stop-verify.sh"],
    "rules": ["hostile-review-protocol.md"]
  },
  "settings_merge": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {"type": "command", "command": "{CLAUDE_HOME}/hooks/debug-first.sh", "timeout": 5}
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {"type": "command", "command": "{CLAUDE_HOME}/hooks/test-result-tracker.sh", "timeout": 5}
          ]
        }
      ],
      "Stop": [
        {
          "matcher": "",
          "hooks": [
            {"type": "command", "command": "{CLAUDE_HOME}/hooks/stop-verify.sh", "timeout": 5}
          ]
        }
      ]
    }
  },
  "claude_md_section": "engineering-discipline"
}
