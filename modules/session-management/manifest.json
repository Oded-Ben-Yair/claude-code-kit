{
  "name": "session-management",
  "version": "2.0.0",
  "description": "Session lifecycle: start, compact, handover, and context recovery",
  "when_to_use": "Any project where you want session continuity — context recovery after restarts, compact/restore, and structured handovers",
  "type": "universal",
  "depends_on": ["core"],
  "files": {
    "skills": ["go/", "end-of-session/"],
    "hooks": ["session-start-enhanced.sh", "post-compact-recover.sh", "pre-compact-save.sh"],
    "templates": ["handover-template.md"]
  },
  "settings_merge": {
    "hooks": {
      "SessionStart": [
        {"matcher": "", "hooks": [{"type": "command", "command": "{CLAUDE_HOME}/hooks/session-start-enhanced.sh", "timeout": 15}]},
        {"matcher": "compact", "hooks": [{"type": "command", "command": "{CLAUDE_HOME}/hooks/post-compact-recover.sh", "timeout": 10}]}
      ],
      "PreCompact": [
        {"matcher": "", "hooks": [{"type": "command", "command": "{CLAUDE_HOME}/hooks/pre-compact-save.sh", "timeout": 30}]}
      ]
    }
  },
  "claude_md_section": "session-management"
}
