{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(tar:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(rm:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "WebSearch",
      "WebFetch",
      "Task",
      "TodoWrite",
      "Skill",
      "SlashCommand",
      "mcp__*",
      "Bash(gcloud:*)",
      "Bash(firebase:*)"
    ],
    "deny": []
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/auto-router.py",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/periodic-commit-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/stop-verify.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/notification.sh 'Claude Code needs your attention'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/session-start-enhanced.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/post-compact-recover.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/pre-compact-save.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/schema-verify.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/quality-validation.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/pre-tool-file-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/deploy-gate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/dead-code-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/debug-first.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/quality-validation.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/pre-tool-file-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/test-result-tracker.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/post-tool-autoformat.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/teammate-idle-verify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/task-completed-verify.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/subagent-stop-tracker.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/tool-failure-tracker.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/config-change-audit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/worktree-audit.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{CLAUDE_HOME}/hooks/worktree-audit.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "{CLAUDE_HOME}/statusline-command.sh"
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": true,
    "superpowers@superpowers-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "ralph-wiggum@claude-code-plugins": true,
    "code-simplifier@claude-plugins-official": true
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Cleopatra lived closer in time to the iPhone than to the Great Pyramid",
      "Ada Lovelace wrote the first computer algorithm in the 1840s",
      "Alan Turing's codebreaking shortened WWII by an estimated 2 years",
      "A smartphone today has more power than Apollo 11's guidance computer",
      "The Chinese Room argues processing symbols isn't understanding",
      "There are more ways to shuffle a deck of cards than atoms on Earth",
      "The birthday paradox: 23 people give 50% odds of a shared birthday",
      "Euler's identity links five fundamental math constants in one equation",
      "Loss aversion means losses sting roughly twice as much as equal gains",
      "The Prisoner's Dilemma shows cooperation crumbles without trust",
      "Infinity comes in sizes \u2014 some infinities are provably larger",
      "Sea otters hold hands while sleeping to avoid drifting apart",
      "Wombat poop is cube-shaped to prevent it from rolling away",
      "Bluetooth is named after a 10th-century Viking king",
      "The trolley problem tests whether outcomes or intentions matter more",
      "Submarine cables carry 99% of intercontinental internet traffic",
      "Moore's Law predicted transistor counts doubling every two years",
      "The Sapir-Whorf idea suggests language can shape how we think",
      "Neutron stars can spin over 700 times per second",
      "Your brain can process an image in just 13 milliseconds",
      "Pi has been computed to 100 trillion digits with no repeating pattern",
      "The golden ratio shows up in the Parthenon and Renaissance art",
      "Dark energy makes up 68% of the universe and is barely understood",
      "The Voyager Golden Record carries Earth sounds into deep space",
      "Memories are stored in connection patterns, not individual neurons"
    ]
  },
  "prefersReducedMotion": true,
  "skipDangerousModePermissionPrompt": true,
  "teammateMode": "auto",
  "mcpServers": {
    "playwright": {
      "command": "{CLAUDE_HOME}/mcp-servers/playwright-cdp/start-edge-mcp.sh",
      "args": [],
      "env": {
        "DISPLAY": ":0"
      },
      "startupTimeout": 30000
    },
    "grok": {
      "command": "{CLAUDE_HOME}/mcp-servers/grok/start-with-env.sh",
      "args": []
    },
    "gemini": {
      "command": "{CLAUDE_HOME}/mcp-servers/gemini-mcp/start.sh",
      "args": [],
      "startupTimeout": 20000
    },
    "claude-mermaid": {
      "command": "npx",
      "args": [
        "claude-mermaid"
      ]
    },
    "vertex-ai": {
      "command": "{CLAUDE_HOME}/mcp-servers/multi-provider-ai/start.sh",
      "args": [],
      "_comment": "Multi-provider AI MCP \u2014 configure API keys in .env"
    }
  },
  "effortLevel": "high"
}
